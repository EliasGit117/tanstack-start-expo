{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["react", "react-native"],
    "baseUrl": ".",
    "paths": {
      "@app": ["src/index.ts"],
      "@app/*": ["src/*"],
      "@navigation": ["../navigation/src/index.ts"]
    }
  },
  "include": ["src/**/*", "nativewind-env.d.ts"]
}
