{
  "name": "tanstack-start-expo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "cd apps/web && bun run dev",
    "web:build": "cd apps/web && bun run build",
    "expo:start": "cd apps/expo && bun run start",
    "expo:ios": "cd apps/expo && bun run ios",
    "expo:android": "cd apps/expo && bun run android",
    "test": "bun --filter '*' test"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ],
  "dependencies": {
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/toggle": "^1.5.2",
    "@rn-primitives/toggle-group": "^1.5.2",
    "lucide-react-native": "^1.23.0"
  }
}
