{
  "name": "tanstack-rnw-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "cd apps/web && bun run dev",
    "mobile": "cd apps/mobile && bun run start",
    "ios": "cd apps/mobile && bun run ios",
    "android": "cd apps/mobile && bun run android",
    "build:web": "cd apps/web && bun run build",
    "test": "bun --filter '*' test"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
}
